{
  "name": "@hexoplon/oxlint-tailwindcss",
  "version": "0.8.6",
  "description": "Tailwind CSS linting rules for oxlint",
  "keywords": [
    "css",
    "linter",
    "oxlint",
    "plugin",
    "tailwind",
    "tailwindcss"
  ],
  "homepage": "https://github.com/Hexoplon/oxlint-tailwindcss#readme",
  "bugs": {
    "url": "https://github.com/Hexoplon/oxlint-tailwindcss/issues"
  },
  "license": "MIT",
  "author": "Sergio Azocar",
  "contributors": [
    "Hexoplon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hexoplon/oxlint-tailwindcss.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --exclude 'tests/benchmarks/**'",
    "test:watch": "vitest --exclude 'tests/benchmarks/**'",
    "bench": "vitest run tests/benchmarks --reporter=verbose --no-file-parallelism",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt .",
    "typecheck": "tsgo --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tailwindcss/node": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.64.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.7.0",
    "@typescript/native-preview": "7.0.0-dev.20260514.1",
    "knip": "^6.13.1",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "^0.22.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@oxlint/plugins": ">=1.43.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
